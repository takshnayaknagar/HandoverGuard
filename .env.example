# Application settings

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Frontend development origin

FRONTEND_ORIGIN=http://localhost:3000

# LLM configuration

# The MVP uses Google Gemini. Get a free API key at https://aistudio.google.com

LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# Put your real key in your local .env file, never in this example file.

GEMINI_API_KEY=
