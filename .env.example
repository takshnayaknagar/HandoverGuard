# Application settings

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Frontend development origin

FRONTEND_ORIGIN=http://localhost:3000

# LLM configuration

# The MVP uses Groq. Create a free API key at https://console.groq.com/keys

LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b

# Put your real key in your local .env file, never in this example file.

GROQ_API_KEY=

# Speech-to-text (local faster-whisper; no API key needed)

STT_TIMEOUT_SECONDS=180
MAX_AUDIO_MB=25

# Optional explicit demo-account provisioning inputs. Do not commit real values.
HANDOVERGUARD_DEMO_USERNAME=
HANDOVERGUARD_DEMO_PASSWORD=
