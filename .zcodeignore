# Environment variables and secrets

.env
.env.*
!.env.example

# Python virtual environments

.venv/
venv/
env/

# Python generated files

__pycache__/
*.py[cod]
*.pyo

# Test and coverage files

.pytest_cache/
.coverage
htmlcov/

# Type checking and linting caches

.mypy_cache/
.ruff_cache/

# IDE and editor files

.vscode/
.idea/

# Operating system files

.DS_Store
Thumbs.db

# Local logs

*.log

# Local databases and temporary data

*.db
*.sqlite3
tmp/
temp/

# Never commit real patient data or private recordings.

# Keep only intentionally created, fictional demo data in version control.

# ===== ↑ 以上同步自 .gitignore（「从 .gitignore 同步」只重写以上部分）=====
.git/
.hg/
.svn/
node_modules/
bower_components/
jspm_packages/
site-packages/
coverage/
lcov-report/
cmakefiles/
cmake-build-*/
bazel-*/
pods/
deriveddata/
storybook-static/
playwright-report/
test-results/
allure-results/
allure-report/
cdk.out/
*.egg-info/
*.dist-info/
eggs/
pip-wheel-metadata/
wheels/
